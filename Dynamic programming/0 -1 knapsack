//0 -1 knapsack using the recursion.
fun main() {
    val value = intArrayOf(15,14,10,45,30)
     val weight = intArrayOf(2,5,1,3,4)
     val w = 7
    val n = value.size
    val dp = Array(n+1){IntArray(w+1){-1}}
   
    println(knapsack(value,weight,w,n))
    println("memoization : ${knapsackMemo(value,weight,w,n,dp)}")
    printDP(dp)
   
}
//Recursion TC: O(2^n)
fun knapsack(value:IntArray,wt:IntArray,w:Int,n:Int):Int{
	if(w == 0 || n == 0){
        return 0
    }
    if(wt[n-1] <= w){ //valid
        //include
        val ans1 = value[n-1] + knapsack(value,wt,w-wt[n-1],n-1)
        //exclude
         val ans2 = knapsack(value,wt,w,n-1)
         return maxOf(ans1, ans2)
    }else{ // not valid
    	return  knapsack(value,wt,w,n-1)
    }
}
//Memoization TC: O(n*w)
//in normal recursion we only change n and w so we just required to made the 2d array
fun knapsackMemo(value:IntArray,wt:IntArray,w:Int,n:Int,dp:Array<IntArray>):Int{
    if (w == 0 || n == 0) {
        return 0
    }
	if(dp[n][w] != -1){
        return dp[n][w]
    }
    if(wt[n-1] <= w){ //valid
        //include
        val ans1 = value[n-1] + knapsackMemo(value,wt,w-wt[n-1],n-1,dp)
        //exclude
         val ans2 = knapsackMemo(value,wt,w,n-1,dp)
         dp[n][w] = maxOf(ans1, ans2)
         return dp[n][w]
    }else{ // not valid
    	 dp[n][w] = knapsackMemo(value,wt,w,n-1,dp)
         return  dp[n][w]
    }
}
fun printDP(dp: Array<IntArray>) {
    for (i in dp.indices) {
        for (j in dp[i].indices) {
            print("${dp[i][j]}\t")
        }
        println()
    }
}

