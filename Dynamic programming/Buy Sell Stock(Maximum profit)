    val arr = intArrayOf(6, 1, 7, 2, 8, 4)
    val fee = 2
    val result = maxProfit(arr, fee)
    println("maxProfit = ${result[0]} \n difference Day = ${result[1]}")
    println("using DP: ${maxProfitDp(arr, fee)}")

}

//Dp 

fun maxProfitDp(arr: IntArray, fee: Int): Int { // Time Complexity: O(n)
    val n = arr.size 

    val dp = Array(n) { IntArray(2) }

    // Base case
    dp[0][0] = 0
    dp[0][1] = -arr[0]

    for (i in 1 until n) {

         dp[i][0] = maxOf(
   				 dp[i-1][0],                  // don't sell - not include
   				 dp[i-1][1] + arr[i] - fee   // sell - include
				)

         dp[i][1] =  maxOf(
   					dp[i-1][1],           // keep holding
  				 	dp[i-1][0] - arr[i]  // buy
				)
    }
    printdp(dp)
		return dp[n - 1][0]
}
fun printdp(dp:Array<IntArray>){
    for(i in 0 until dp.size){
        for(j in 0 until dp[i].size){
            print("${dp[i][j]}\t")
        }
        println()
    }
}
// sliding window
fun maxProfit(arr: IntArray, fee: Int): IntArray { //TC = O(n²)
    val n = arr.size
    
     val result = intArrayOf(0, 0)

   	 var diffDay = 1
    while(diffDay < n){
        var left = 0
        var right = diffDay
        var sum = 0
        while(right < n){
            val profit = (arr[right] - arr[left]) - fee
            if(profit > 0){
              	 //add profit
                sum += profit
            }
            left++
            right++
        }
        if(sum > result[0]){
            result[0] = sum
            result[1] = diffDay
        }
        diffDay++
    }
    return result
}
