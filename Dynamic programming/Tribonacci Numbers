fun main() {
    val num = 19
     println(tribonacci(num))
}
fun tribonacci(num:Int):Int{
    if (num == 0) return 0
    if (num == 1) return 0
    if (num == 2) return 1
    
    val dp = IntArray(num+1)
    dp[0] = 0
    dp[1] = 0
    dp[2] = 1
    
    for(i in 3..num){
        dp[i] = dp[i-1] + dp[i-2] + dp[i-3]
    }
    return dp[num]
}
