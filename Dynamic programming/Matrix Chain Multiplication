/*
 Approach       | Time    | Space
---------------|---------|--------------------------------
Recursion      | O(3^n)  | O(n) call stack
Memoization    | O(n^3)  | O(n^2) dp + O(n) call stack
Tabulation     | O(n^3)  | O(n^2) dp, no call stack
 * */
// Note: In MCM memoization is better approch. 
fun main() {
 val arr = intArrayOf(1,2,3,4,3)
    val dp = Array(arr.size+1){IntArray(arr.size+1){-1}}
   	  println("Recursion: ${mcmRec(arr,1,arr.size-1)}")
      println("Memozation: ${mcmMemo(arr,1,arr.size-1,dp)}")
      println("Tabulation: ${mcmTab(arr)}")
}

fun mcmRec(arr:IntArray,i:Int,j:Int):Int{
    if(i == j){ //single matrix
        return 0
    }
    var ans = Int.MAX_VALUE
    for(k in i until j){
      val cost1 = mcmRec(arr,i,k) //Ai..Ak
      val cost2 = mcmRec(arr,k+1,j) //Ai+1..Aj
      val cost3 = arr[i-1] * arr[k] * arr[j]
        val finalCost = cost1 + cost2 + cost3
        ans = minOf(ans,finalCost)
    }
    return ans //minCost
}
fun mcmMemo(arr:IntArray,i:Int,j:Int,dp:Array<IntArray>):Int{
    if(i == j){ //single matrix
        return 0
    }
    if(dp[i][j] != -1){return dp[i][j]}
    var ans = Int.MAX_VALUE
    for(k in i until j){
      val cost1 = mcmMemo(arr,i,k,dp) //Ai..Ak
      val cost2 = mcmMemo(arr,k+1,j,dp) //Ai+1..Aj
      val cost3 = arr[i-1] * arr[k] * arr[j]
        val finalCost = cost1 + cost2 + cost3
        ans = minOf(ans,finalCost)
    }
    dp[i][j] = ans
    return ans //minCost
}
fun mcmTab(arr:IntArray):Int{
 	  val n =  arr.size
      val dp = Array(n){IntArray(n){0}}
      for(i in 0 until n){ // Diagonaly fill 0 in table(dp)
          dp[i][i] = 0
      }
      for(len in 2 until n){
          for(i in 1..n-len){
              val j = i + len -1 //column
              dp[i][j] = Int.MAX_VALUE
                for(k in i until j){
      				  val cost1 = dp[i][k]
    				  val cost2 = dp[k+1][j]
    				  val cost3 = arr[i-1] * arr[k] * arr[j]
     				  val finalCost = cost1 + cost2 + cost3
        			  dp[i][j] = minOf(dp[i][j],finalCost)
   			 }
          }
      }
      return  dp[1][n-1]
}
