//Longest Common Subsequence.
fun main() {
    val str1 = "abcd"
    val str2 = "ac"
     val dp = Array(str1.length+1){IntArray(str2.length+1){-1}}
    println("Recurrsion : ${lcs(str1,str2,str1.length,str2.length)}")
    println("Memoziation : ${lcsMemoization(str1,str2,str1.length,str2.length,dp)}")
    println("Tabulazation : ${lcsTabulazation(str1,str2,str1.length,str2.length)}")
}

//Recurssion TC:O(2^(n+m)) — exponential, very slow,Space: O(n+m) — max depth of the recursion stack
//Space: O(n+m) — max depth of the recursion stack
fun lcs(str1:String,str2:String,n:Int,m:Int):Int{
    if(n == 0 || m == 0){
        return 0
    }
    if(str1[n-1] == str2[m-1]){
        return lcs(str1,str2,n-1,m-1) + 1
    }else{
        val ans1 = lcs(str1,str2,n-1,m)
        val ans2 = lcs(str1,str2,n,m-1)
        return maxOf(ans1,ans2)
    }
}

//Memoization TC:O(n × m)
fun lcsMemoization(str1:String,str2:String,n:Int,m:Int,dp:Array<IntArray>):Int{
    if(n == 0 || m == 0){
        return 0
    }
    if(dp[n][m] != -1){
        return dp[n][m]
    }
    if(str1[n-1] == str2[m-1]){
         dp[n][m] = lcsMemoization(str1,str2,n-1,m-1,dp) + 1
         return dp[n][m]
    }else{
        val ans1 = lcsMemoization(str1,str2,n-1,m,dp)
        val ans2 = lcsMemoization(str1,str2,n,m-1,dp)
        dp[n][m] = maxOf(ans1,ans2)
        return dp[n][m]
    }
}
//Tabulazation TC:O(n × m)
fun lcsTabulazation(str1:String,str2:String,n:Int,m:Int):Int{
     val dp = Array(str1.length+1){IntArray(str2.length+1){0}}    
     for(i in 1 until n+1){
         for(j in 1 until m+1){
             if(str1[i-1] == str2[j-1]){ //valide
                  // Characters match
                dp[i][j] = 1 + dp[i - 1][j - 1]
             } else {
                 // Characters don't match
                 val ans1 = dp[i - 1][j]
                 val ans2 =  dp[i][j - 1]
                dp[i][j] = maxOf(
                    ans1,
                    ans2
                )
             }
         }
     }
        return dp[n][m]
}
