/*
 ### Wildcard Matching

Wildcard Matching checks whether a string matches a given pattern.

* `?` → Matches any **single character**.
* `*` → Matches **zero or more characters (a sequence)**.

**Example:**

```text
String  = "baaabab"
Pattern = "ba*a?"

Output = true
```

Here, `*` matches a sequence of characters and `?` matches one character.

 * */
fun main() {
   val str1 = "baaabab"
    val str2 = "ba*a?"
    println("Tabulazation: ${isMatch(str1,str2)}")
}


fun isMatch(s:String,p:String):Boolean{
    val n = s.length
    val m = p.length
    val dp = Array(n+1){BooleanArray(m+1)}
    dp[0][0] = true
   
     for(j in 1 until m+1){ //s is empty
    		if(p[j-1] == '*'){
                dp[0][j] = dp[0][j-1]
            }
     }
     
    for(i in 1 until n+1){
        for(j in 1 until m+1){
            if(s[i-1] == p[j-1] || p[j-1] == '?'){
                dp[i][j] = dp[i-1][j-1]
            }else if(p[j-1] == '*'){
                 dp[i][j] = dp[i-1][j] ||  dp[i][j-1]
            }else{
                dp[i][j] = false
            }
        }
    }
    printdp(dp)
    return dp[n][m]
}
fun printdp(dp:Array<BooleanArray>){
    for(i in 0 until dp.size){
        for(j in 0 until dp[i].size){
            print("${dp[i][j]}\t")
        }
        println()
    }
}
