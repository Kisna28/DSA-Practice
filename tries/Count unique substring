fun countNodes(root:Node?):Int{
        if(root == null){
            return 0
        }
        
        var count = 0
        for(i in 0 until 26){
            if(root.child[i] != null){
                count  += countNodes(root.child[i])
            }
        }
        return count + 1 // +1 for the empty string
    }
