    fun detectCycle(graph: Array<MutableList<Edge>>):Boolean{
        val n = graph.size
        val vis = BooleanArray(n)
        for(i in 0 until n){
            if(!vis[i]){
                if(detectCycleUtils(graph,vis,i,-1)) { //-1 because at start we not have parent
                   return true
                }
			}
        }
        return false
    }
    
    fun detectCycleUtils(path: Array<MutableList<Edge>>,vis:BooleanArray,curr:Int,parent:Int):Boolean{
        vis[curr] = true
        for(e in graph[curr]){
            if(!vis[e.dest]){
                if(detectCycleUtils(graph,vis,e.dest,curr)){
                    return true
                }
            }else if(e.dest != parent){
                    return true
                }
            }
        return false
    }
  
