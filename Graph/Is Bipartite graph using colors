    fun isBipartite(graph:Array<MutableList<Edge>>):Boolean{
       val col = IntArray(graph.size) { -1 }

       val q = ArrayDeque<Int>()
       for(i in 0 until graph.size){
           if(col[i] == -1){
               q.addLast(i)
               col[i] = 0 //yello
               
               while(q.isNotEmpty()){
                   val curr = q.removeFirst()
                   
                   for(e in graph[curr]){
                       if(col[e.dest] == -1){
                           col[e.dest] = if (col[curr] == 0) {1} else {0}
                           q.addLast(e.dest)
                       }else if(col[e.dest] == col[curr]){
                           return false
                       }
                   }
               }
           }
       }
        return true
    }
    
  
