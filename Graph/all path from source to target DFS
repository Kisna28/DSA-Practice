     fun printAllPathBfs(graph:Array<MutableList<Edge>>,src:Int,dest:Int){
         val q = ArrayDeque<List<Int>>()
         q.addLast(listOf(src))
         while(q.isNotEmpty()){
             val path = q.removeFirst()
             val curr = path.last()
             if(curr == dest){
                 println(path.joinToString(" -> "))
                 continue
             }
             
             for(e in graph[curr]){
                 val newPath = path + e.dest
                 q.addLast(newPath)
             }
         }
     }

    fun printAllPathDfs(graph:Array<MutableList<Edge>>,src:Int,dest:Int,path:String){
        if(src == dest){
            println("${path+dest}")
            return
        }
        for(e in graph[src]){
            printAllPathDfs(graph,e.dest,dest,path+src)
        }
    }
