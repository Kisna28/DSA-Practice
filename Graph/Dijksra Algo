import java.util.PriorityQueue
class Graph() {
    data class Edge(
    	val src:Int,
        val dest: Int,
        val wt:Int
    )
    val V = 5
    val graph = Array(V){ mutableListOf<Edge>() }
    init{ //Loops, if, when, println, graph[i].add(...) → executable statements, so they must be inside an init block or a function.
        
    
        /*
  
             2
          ┌──────► 1
          │         │
          │         │ 3
          │         ▼
          0         3
          │         │
          │ 4       │ 2
          ▼         ▼
          4 ◄───────┘
          │
          │ 1
          ▼
          2
          
          */
graph[0].add(Edge(0, 1, 2))
graph[0].add(Edge(0, 4, 4))

graph[1].add(Edge(1, 3, 3))

graph[3].add(Edge(3, 4, 2))

graph[4].add(Edge(4, 2, 1))
     
      dijksra(graph,0)
   
    }
    
     fun dijksra(graph:Array<MutableList<Edge>>,src:Int){
     val dist = IntArray(graph.size) { Int.MAX_VALUE }
	dist[src] = 0
        val vis = BooleanArray(graph.size)
         val pq = PriorityQueue<Pair>() // OR  val pq = PriorityQueue<Pair>(compareBy { it.path })
        pq.add(Pair(src,0))
        while(pq.isNotEmpty()){
            val curr = pq.remove()
            if (vis[curr.n]) {
           		 continue
       			 }
         
                vis[curr.n] = true
            
            for(e in graph[curr.n]){
                val u = e.src
                val v = e.dest
                val wt = e.wt
                if(dist[u] + wt < dist[v]){
                    dist[v] = dist[u] + wt
                    pq.add(Pair(v,dist[v]))
                }
            }
        }
     
    for (i in dist.indices) {
        println("Distance from $src to $i = ${dist[i]}")
    }
     }
  data class Pair(
    val n: Int,
    val path: Int
) : Comparable<Pair> {

    override fun compareTo(p2: Pair): Int {
        return this.path - p2.path // OR          return this.path.compareTo(p2.path)
    }
}
}
