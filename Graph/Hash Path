         graph[1].add(Edge(1,3,3))     //1 - vertex
         graph[2].add(Edge(2,0,1))     //2 - vertex
         graph[2].add(Edge(2,4,1))     //2 - vertex
         graph[3].add(Edge(3,1,3))     //3 - vertex
         graph[3].add(Edge(3,4,1))     //3 - vertex
         graph[3].add(Edge(3,5,1))     //3 - vertex
         graph[4].add(Edge(4,2,2))     //4 - vertex
         graph[4].add(Edge(4,3,2))     //4 - vertex
         graph[4].add(Edge(4,5,2))     //4 - vertex
         graph[5].add(Edge(5,3,2))     //5 - vertex
         graph[5].add(Edge(5,4,2))     //5 - vertex
         graph[5].add(Edge(5,6,2))     //5 - vertex
         graph[5].add(Edge(6,5,2))     //5 - vertex
         
    
         println("Hash Path or not: ")
         print(hashPath(graph,0,5,BooleanArray(V){false}))
    }
   
    //Hash Path : src = 0 and dest = 5 o/p = true
    
    fun hashPath(graph:Array<MutableList<Edge>>,src:Int,dest:Int,vis:BooleanArray):Boolean{
        if(src == dest){ return true}
        vis[src] = true
        for(i in 0 until graph[src].size){
            val e = graph[src].get(i)
            if(!vis[e.dest]  &&  hashPath(graph,e.dest,dest,vis)){
                return true
            }
        }
        return false
    }
         
}
// OTHER APPROCH //Leetcode : 1971
class Solution {

    fun validPath(n: Int, edges: Array<IntArray>, source: Int, destination: Int): Boolean {
     val graph = Array(n) { mutableListOf<Int>() }
        for (edge in edges) {
            val u = edge[0]
            val v = edge[1]

            graph[u].add(v)
            graph[v].add(u)
        }

        val vis = BooleanArray(n)
        fun dfs(curr: Int): Boolean {
            if (curr == destination) return true

            vis[curr] = true

            for (next in graph[curr]) {
                if (!vis[next] && dfs(next)) {
                    return true
                }
            }

            return false
        }
           return dfs(source)

    }
}
