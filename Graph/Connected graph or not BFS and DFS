    }
    
    fun dfsUtils(
        graph: Array<MutableList<Edge>>,
        current: Int,
        visited: BooleanArray
    ) {
        visited[current] = true
        
            for (edge in graph[current]) {

                val next = edge.dest

                if (!visited[next]) {

                    dfsUtils(graph, next, visited)
                }
            }
          }
    
fun dfs(graph: Array<MutableList<Edge>>): Boolean { //O(V + E)
    val visited = BooleanArray(graph.size)
    // Start DFS from vertex 0
    dfsUtils(graph, 0, visited)

    // Check if every vertex was visited
        for (i in visited.indices) {
            if (!visited[i]) {
                return false
            }
        }

        return true
  }
    
     fun bfsUtils(
        graph: Array<MutableList<Edge>>,
        start: Int,
        visited: BooleanArray
    ) {

        val queue = ArrayDeque<Int>()

        queue.add(start)
        visited[start] = true

        while (queue.isNotEmpty()) {

            val current = queue.removeFirst()

            for (edge in graph[current]) {

                val next = edge.dest

                if (!visited[next]) {

                    visited[next] = true
                    queue.add(next)
                }
            }
        }
    }
fun bfs(graph: Array<MutableList<Edge>>): Boolean { //O(V + E)
    val visited = BooleanArray(graph.size)
    // Start BFS from vertex 0
    bfsUtils(graph, 0, visited)

    // Check if every vertex was visited
        for (i in visited.indices) {
            if (!visited[i]) {
                return false
            }
        }

        return true
  }
}
