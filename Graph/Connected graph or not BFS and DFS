        4

	6

         * */
        
  		 graph[0].add(Edge(0, 1, 5))
   		 graph[0].add(Edge(0, 2, 5))

    // 1
    graph[1].add(Edge(1, 0, 1))
    graph[1].add(Edge(1, 3, 1))

