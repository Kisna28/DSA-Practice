    fun detectCycleDfs(graph: Array<MutableList<Edge>>):Boolean{
        val n = graph.size
        val vis = BooleanArray(n)
        for(i in 0 until n){
            if(!vis[i]){
                if(detectCycleUtilsDfs(graph,vis,i,-1)) { //-1 because at start we not have parent
                   return true
                }
			}
        }
        return false
    }
    
    fun detectCycleUtilsDfs(path: Array<MutableList<Edge>>,vis:BooleanArray,curr:Int,parent:Int):Boolean{
        vis[curr] = true
        for(e in graph[curr]){
            if(!vis[e.dest]){
                if(detectCycleUtilsDfs(graph,vis,e.dest,curr)){
                    return true
                }
            }else if(e.dest != parent){
                    return true
                }
            }
        return false
    }
    
    fun detectCycleBfs(graph: Array<MutableList<Edge>>):Boolean{
        val n = graph.size
         val vis = BooleanArray(n)
       	    // Queue stores: Pair(currentNode, parent)
   			 val q = ArrayDeque<Pair<Int, Int>>()
        for(i in 0 until n){
             if(!vis[i]){
              q.add(Pair(i,-1))
              vis[i] = true
                 
                 while(q.isNotEmpty()){
                     val (curr,parent) = q.removeFirst()
                     
                     for(e in graph[curr]){
                         if(!vis[e.dest]){
                             vis[e.dest] = true
                             
                             q.add(Pair(e.dest,curr))
                         }else if (e.dest != parent) {
                        		return true
                    	}
               
                     }
                 }
			}
        }
        return false        
    }
  
