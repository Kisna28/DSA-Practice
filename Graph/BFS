class Graph(){

data class Edge(
    	val src:Int,
        val dest: Int,
        val wt:Int
    )
    val V = 5
    val graph = Array(V){ mutableListOf<Edge>() }
    init{ //Loops, if, when, println, graph[i].add(...) → executable statements, so they must be inside an init block or a function.
  		 graph[0].add(Edge(0,1,5))     //0 - vertex
         graph[1].add(Edge(1,2,1))     //1 - vertex
         graph[1].add(Edge(1,3,3))     //1 - vertex
         graph[1].add(Edge(1,0,5))     //1 - vertex
         graph[2].add(Edge(2,1,1))     //2 - vertex
         graph[2].add(Edge(2,3,1))     //2 - vertex
         graph[2].add(Edge(2,4,2))     //2 - vertex
         graph[3].add(Edge(3,1,3))     //3 - vertex
         graph[3].add(Edge(3,2,1))     //3 - vertex
         graph[4].add(Edge(4,2,2))     //4 - vertex
bfs(graph)
}
    fun bfs(graph:Array<MutableList<Edge>>){ // O(V+E)
        val q = ArrayDeque<Int>()
        val vis = BooleanArray(graph.size){false}
        q.addLast(0) //source = 0
        
        while(q.isNotEmpty()){
            val curr = q.removeFirst()
            if(!vis[curr]){ // visit curr
                println(curr)
                vis[curr] = true
                
               for(i in 0 until graph[curr].size){
                   val e = graph[curr].get(i) //neighbours find
                   q.addLast(e.dest)
                }
            }
        }
    }
}
