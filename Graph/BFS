class Graph() {
    data class Edge(
    	val src:Int,
        val dest: Int,
        val wt:Int
    )
    val V = 7
    val graph = Array(V){ mutableListOf<Edge>() }
    init{ //Loops, if, when, println, graph[i].add(...) → executable statements, so they must be inside an init block or a function.
  		 graph[0].add(Edge(0,1,5))     //0 - vertex
         graph[0].add(Edge(0,2,5))     //0 - vertex
         graph[1].add(Edge(1,0,1))     //1 - vertex
         graph[1].add(Edge(1,3,3))     //1 - vertex
         graph[2].add(Edge(2,0,1))     //2 - vertex
         graph[2].add(Edge(2,4,1))     //2 - vertex
         graph[3].add(Edge(3,1,3))     //3 - vertex
         graph[3].add(Edge(3,4,1))     //3 - vertex
         graph[3].add(Edge(3,5,1))     //3 - vertex
         graph[4].add(Edge(4,2,2))     //4 - vertex
         graph[4].add(Edge(4,3,2))     //4 - vertex
         graph[4].add(Edge(4,5,2))     //4 - vertex
         graph[5].add(Edge(5,3,2))     //5 - vertex
         graph[5].add(Edge(5,4,2))     //5 - vertex
         graph[5].add(Edge(5,6,2))     //5 - vertex
         graph[5].add(Edge(6,5,2))     //5 - vertex
         
        //2's neighbours
        
        for(i in 0 until graph[2].size){
            val e = graph[2].get(i)
            print("2->${e.dest}\n")
        }
        println("BFS")
        bfs(graph)
        println("DFS")
        dfs(graph,0,BooleanArray(V){false})
    }
    
    //BFS : use Queue
    
    fun bfs(graph:Array<MutableList<Edge>>){ // O(V+E)
         val q = ArrayDeque<Int>()
        val vis = BooleanArray(graph.size){false}
        q.addLast(0) //source = 0
        
        while(q.isNotEmpty()){
            val curr = q.removeFirst()
            if(!vis[curr]){ // visit curr
                println(curr)
                vis[curr] = true
                
               for(i in 0 until graph[curr].size){
                   val e = graph[curr].get(i) //neighbours find
                   q.addLast(e.dest)
                }
            }
        }
    }
    //DFS : use Stack(recurssion)
   
    fun dfs(graph:Array<MutableList<Edge>>,curr:Int,vis:BooleanArray){ // O(V+E)
        println(curr) //visit
        vis[curr] = true
        
        for(i in 0 until graph[curr].size){
            val e = graph[curr].get(i) //neighbours find
            if(!vis[e.dest]){
                dfs(graph,e.dest,vis)
            }
        }
             
    }
         
}
fun main() {
    val graph = Graph()
}
