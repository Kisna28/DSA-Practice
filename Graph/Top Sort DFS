class Graph() {
    data class Edge(
        val src: Int,
        val dest: Int,
        val wt: Int
    )

    val V = 6
    val graph = Array(V) { mutableListOf<Edge>() }

    init { //Loops, if, when, println, graph[i].add(...) → executable statements, so they must be inside an init block or a function.


      //cycle is present
        
      
        graph[2].add(Edge(2, 3, 1))

        graph[3].add(Edge(3, 1, 1))

        graph[4].add(Edge(4, 0, 1))
        graph[4].add(Edge(4, 1, 1))
        
        graph[5].add(Edge(5, 0, 1))
        graph[5].add(Edge(5, 2, 1))
        

        /*
                0
               / \
               ↓   ↓
               1   2
               / \
               ↓   ↓
               3   4
               */

        //Cycle is not present
      /*  graph[0].add(Edge(0, 1, 1))
            graph[0].add(Edge(0, 2, 1))

         graph[1].add(Edge(1, 3, 1))
         graph[1].add(Edge(1, 4, 1))  */

        topSort(graph)
    }

    fun topSort(graph: Array<MutableList<Edge>>) {
        val n = graph.size
        val vis = BooleanArray(n)
        val stack = ArrayDeque<Int>()
        for (i in 0 until n) {
            if (!vis[i]) {
                topSortUtils(graph, i,vis, stack)
                 }
        }
        while(stack.isNotEmpty()){
            print(stack.removeLast())
        }
    }

    fun topSortUtils(
        graph: Array<MutableList<Edge>>,
        curr: Int,
        vis: BooleanArray,
        stack: ArrayDeque<Int>,
    ) {
        vis[curr] = true

        for (e in graph[curr]) {
             if (!vis[e.dest]) {
                topSortUtils(graph, e.dest, vis, stack)
            }
        }
        stack.addLast(curr)
    }
}

fun main() {
    val graph = Graph()
