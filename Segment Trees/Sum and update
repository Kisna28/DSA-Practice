lateinit var tree: IntArray  
fun init(n: Int) {
    tree = IntArray(4 * n)
}
fun buildSTree(arr:IntArray,sti:Int,start:Int,end:Int):Int{
    //sti   -> WHERE to store the answer in tree[]
    if(start == end){
        tree[sti] = arr[start]
        return arr[start]
    }
    val mid = (start + end)/2
    buildSTree(arr,2*sti+1,start,mid)
    buildSTree(arr,2*sti+2,mid+1,end)
    tree[sti] = tree[2*sti+1] + tree[2*sti+2]
    return tree[sti]
}

fun getSumUtils(i:Int,si:Int,sj:Int,qi:Int,qj:Int):Int{ //o(logn)
    if(qj < si || qi > sj){// non overlapping
    return 0
    }else if(si >= qi && sj <= qj){//complete overlap
        return tree[i]
    }else{
    	val mid = (si + sj)/2
        val left = getSumUtils(2 * i + 1 , si,mid,qi,qj)
        val right = getSumUtils(2 * i + 2, mid+1,sj,qi,qj)
        return left + right
    }    
}
fun getSum(arr:IntArray,qi:Int,qj:Int):Int{
    val n = arr.size
   return getSumUtils(0,0,n-1,qi,qj)
}
fun updateUtil(i:Int,si:Int,sj:Int,idx:Int,diff:Int){ //O(logn)
		if(idx > sj || idx < si){return}
			
        tree[i] += diff
    if(si != sj){ //non leaf
     val mid = (si + sj)/2
        updateUtil(2*i+1 , si, mid , idx , diff) //left
         updateUtil(2*i+2 , mid+1, sj , idx , diff) //right
    }
   
}

fun update(arr:IntArray,idx:Int,newValue:Int){
    val n = arr.size
    val diff = newValue - arr[idx]
    arr[idx] = newValue
    updateUtil(0,0,n-1,idx,diff)
}

fun main() {
    val arr = intArrayOf(1,2,3,4,5)
    val n = arr.size
   init(n)
   buildSTree(arr,0,0,n-1)
    println("Sum(1, 3) = ${getSum(arr, 1, 3)}")   // 9
   println(tree.joinToString(" ,"))
   // update tree
   update(arr,0,2)
    println(tree.joinToString(" ,"))
}
